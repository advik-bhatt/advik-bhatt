#!/bin/sh
# main-only guard: no model IDs and no AI attribution in commit messages.
f="$1"
if grep -qiE 'claude-(fable|opus|sonnet|haiku|mythos)[0-9a-z.-]*|claude-[0-9]' "$f"; then
  echo "main-only guard: model IDs never go in commit messages." >&2
  exit 1
fi
if grep -qiE 'co-authored-by:.*(claude|anthropic)|noreply@anthropic\.com|claude\.ai/code|generated with .{0,3}claude' "$f"; then
  echo "main-only guard: no AI attribution trailers in commit messages." >&2
  exit 1
fi
exit 0
